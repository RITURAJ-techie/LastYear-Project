# Copy to .env and adjust. All values are optional.

# Optional: enables Claude-powered executive briefings and free-form text-to-SQL.
# Without it every feature still works using the built-in statistics/ML/NLP engine.
ANTHROPIC_API_KEY=

# Model used for the optional generative-AI features
INSIGHTFLOW_AI_MODEL=claude-opus-5-5

# JWT signing secret (auto-generated and stored in the data dir if empty)
INSIGHTFLOW_SECRET_KEY=

# Create the demo account (demo@insightflow.ai / demo1234) with sample data on first start
INSIGHTFLOW_SEED_DEMO=true

# Run scheduled ETL refreshes in the background
INSIGHTFLOW_SCHEDULER=true

# Max upload size in MB
INSIGHTFLOW_MAX_UPLOAD_MB=200
